# Plain RHEL9 with a sudo user, to try install.sh by hand like on the real box:
#   docker build -t kide-plain -f test/Containerfile.plain test
#   docker run --rm -it kide-plain
# then: curl -fsSL https://raw.githubusercontent.com/kreatos/kide/main/install.sh | bash
# (sudo password: misw). Sample projects to try kide on: ~/proj (test/proj).
FROM registry.access.redhat.com/ubi9/ubi:latest
RUN dnf -y install sudo && dnf clean all \
    && useradd -m -G wheel misw && echo misw:misw | chpasswd
COPY --chown=misw:misw proj /home/misw/proj
USER misw
WORKDIR /home/misw
CMD ["bash", "-l"]
